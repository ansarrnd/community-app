rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function hasRole(role) { return isAuth() && request.auth.token.role == role; }
    function isModOrAdmin() { return isAuth() && (request.auth.token.role == 'MOD' || request.auth.token.role == 'ADMIN'); }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    match /events/{eventId} {
      allow read: if resource.data.status == 'APPROVED' || isAuth();
      allow create: if isAuth() && request.resource.data.organizerId == request.auth.uid;
      allow update: if isAuth() && (
        isModOrAdmin() ||
        (resource.data.organizerId == request.auth.uid && request.resource.data.status == resource.data.status)
      );
      allow delete: if isAuth() && (isModOrAdmin() || resource.data.organizerId == request.auth.uid);
    }

    match /rsvps/{rsvpId} {
      allow read, write: if isAuth();
    }

    match /templates/{templateId} {
      allow read: if isAuth();
      allow write: if hasRole('ADMIN');
    }

    // Kinship Network Collections (Cleanly Separated from /events)
    match /persons/{personId} {
      allow read, write: if isAuth();
    }

    match /relationships/{relationshipId} {
      allow read, write: if isAuth();
    }

    match /villages/{villageId} {
      allow read, write: if isAuth();
    }
  }
}

