{
  "name": "community-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/patch-web-export.mjs",
    "emulators": "firebase emulators:start",
    "seed": "npx ts-node scripts/seed.ts",
    "og:generate": "npx ts-node scripts/generate-og-preview.ts",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "jest __tests__/integration",
    "test:perf": "jest __tests__/perf",
    "test:snapshots": "jest Snapshots",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:ios": "node scripts/capture-screenshots.mjs ios",
    "screenshots:android": "node scripts/capture-screenshots.mjs android",
    "screenshots:native:ios": "maestro test .maestro/ios/screenshots.yaml",
    "screenshots:native:android": "maestro test .maestro/android/screenshots.yaml",
    "screenshots:candidate": "node scripts/capture-screenshots.mjs --candidate",
    "screenshots:compare": "node scripts/compare-screenshots.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-native-community/netinfo": "11.5.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@tanstack/query-sync-storage-persister": "^5.51.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "^55.0.0",
    "expo-blur": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-modules-core": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "firebase": "^10.12.4",
    "lucide-react-native": "^0.417.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.52.1",
    "react-native": "0.83.10",
    "react-native-mmkv": "^2.12.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~55.0.0",
    "firebase-admin": "^12.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  },
  "private": true
}
